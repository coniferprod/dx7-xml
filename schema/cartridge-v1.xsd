<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" version="0.1">

    <xs:annotation>
        <xs:documentation>
            This schema defines the structure of DX7 cartridge data.
            A cartridge always contains 32 voices.
        </xs:documentation>
    </xs:annotation>
    
    <xs:include schemaLocation="voice-v1.xsd"/>

    <xs:element name="voices">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="voice" minOccurs="32" maxOccurs="32"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="cartridge">
        <xs:complexType>
            <xs:all>
                <xs:element ref="voices"/>
            </xs:all>
        </xs:complexType>
    </xs:element>

</xs:schema>
