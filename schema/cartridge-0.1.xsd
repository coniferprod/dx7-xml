<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" version="0.1">

    <xs:include schemaLocation="voice-0.1.xsd"/>

    <xs:element name="voices">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="voice" minOccurs="32" maxOccurs="32"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="cartridge">
        <xs:complexType>
            <xs:all>
                <xs:element ref="voices"/>
            </xs:all>
        </xs:complexType>
    </xs:element>

</xs:schema>
